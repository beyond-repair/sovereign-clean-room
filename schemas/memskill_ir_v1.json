{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adl-seem.org/schemas/memskill_ir_v1.json",
  "title": "Canonical MemSkill IR v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ir_version",
    "skillId",
    "invertibilityScore",
    "maxExecutionMs",
    "networkAccessPermitted",
    "verificationHash",
    "transitions"
  ],
  "properties": {
    "ir_version": {"const": "memskill-ir-v1"},
    "skillId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "invertibilityScore": {"type": "number", "minimum": 0.92, "maximum": 1.0},
    "maxExecutionMs": {"type": "integer", "minimum": 1, "maximum": 5000},
    "networkAccessPermitted": {"const": false},
    "verificationHash": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "transitions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stepIndex", "operatorSymbol", "resourceCost"],
        "properties": {
          "stepIndex": {"type": "integer", "minimum": 0},
          "operatorSymbol": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
          "resourceCost": {"type": "integer", "minimum": 0, "maximum": 100}
        }
      }
    }
  }
}
